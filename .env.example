# ---------------------------------------------------------------------------
# Asset IQ — copy to .env (root: ingest service, evals, MCP) and apps/web/.env.local (web).
# Local values come from `pnpm db:status` (Supabase CLI). Never commit real keys.
# ---------------------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:55321          # server-side (ingest, MCP, evals)
SUPABASE_SERVICE_ROLE_KEY=

# LLMs (Anthropic) — model IDs are config, not code
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# Embeddings (OpenAI) — must match between ingest and query
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Reranking (optional; falls back to RRF order)
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_ENABLED=false

# Vector backend: pgvector (default) | mongodb
VECTOR_BACKEND=pgvector
MONGODB_URI=
MONGODB_DB=asset_iq

# Ingestion service
INGEST_SERVICE_URL=http://localhost:8000
INGEST_SHARED_SECRET=change-me-to-a-long-random-string
POLL_INTERVAL_SECONDS=5

# Rate limiting (per user, chat + agent)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=600

# Demo user (seed script + evals + Playwright)
DEMO_USER_EMAIL=demo@asset-iq.local
DEMO_USER_PASSWORD=
ASSET_IQ_URL=http://localhost:3000

# MCP
ASSET_IQ_API_KEY=          # created at /settings in the web app
MCP_PORT=3333
