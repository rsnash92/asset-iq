{
  "name": "@asset-iq/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mongo:sync": "tsx --env-file-if-exists=../../.env scripts/mongo-sync.ts",
    "test:integration": "vitest run --config vitest.integration.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.105",
    "@supabase/supabase-js": "2.119.0",
    "ai": "7.0.173",
    "cohere-ai": "8.3.1",
    "mongodb": "7.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "5.1.0"
  }
}
